{
  "functions": {
    "api/advisor.js": {
      "maxDuration": 30
    },
    "api/climate.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src 'self' https://fonts.gstatic.com https://cdn.fontshare.com; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/business",
      "destination": "/commercial.html"
    },
    {
      "source": "/prototype",
      "destination": "/commercial.html"
    },
    {
      "source": "/markets",
      "destination": "/commercial.html"
    },
    {
      "source": "/partners",
      "destination": "/commercial.html"
    },
    {
      "source": "/incentives",
      "destination": "/commercial.html"
    },
    {
      "source": "/investors",
      "destination": "/commercial.html"
    },
    {
      "source": "/enterprise",
      "destination": "/commercial.html"
    }
  ]
}
