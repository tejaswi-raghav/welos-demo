# Contact form delivery — configure ONE of the options below.
# Option A: Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="WELOS Website <noreply@your-verified-domain.com>"
# Option B: any HTTPS webhook that accepts JSON (Slack workflow, Zapier, n8n, your API)
CONTACT_WEBHOOK_URL=
# Static hosting only (STATIC_EXPORT=1): a form endpoint the browser can POST JSON to (e.g. Formspree)
NEXT_PUBLIC_CONTACT_ENDPOINT=
