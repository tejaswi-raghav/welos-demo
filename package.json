{
  "name": "welos-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:control": "node --test src/control/engine.test.js",
    "test:model": "node --test src/model/parts.test.js",
    "check": "npm run test:control && npm run test:model && npm run test:site && npm run test:twin && npm run test:business && npm run test:commercial && npm run check:protected && npm run build",
    "firmware:build": "pio run -d firmware",
    "test:site": "node --test src/site/*.test.js api/advisor.test.js",
    "test:twin": "node --test src/twin/sim.test.js src/twin/topology.test.js",
    "test:business": "node --test src/gen1/*.test.js src/business/*.test.js",
    "check:protected": "node scripts/check-protected.mjs",
    "export:business": "node scripts/export-business.mjs",
    "prebuild": "node scripts/export-business.mjs",
    "test:commercial": "node --test src/commercial/*.test.js api/commercial-research.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.186.0",
    "vite": "^5.4.10"
  }
}
